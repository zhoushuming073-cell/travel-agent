{
  "name": "smart-travel-assistant-cn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node node_modules/cross-env/dist/bin/cross-env.js WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node node_modules/cross-env/dist/bin/cross-env.js WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node node_modules/cross-env/dist/bin/cross-env.js WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:domain && npm run build",
    "test:domain": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
    ,"orchestrator:dev": "wrangler dev --config orchestrator/wrangler.jsonc"
    ,"orchestrator:deploy": "wrangler deploy --config orchestrator/wrangler.jsonc"
    ,"orchestrator:types": "wrangler types --config orchestrator/wrangler.jsonc orchestrator/worker-configuration.d.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "cross-env": "10.1.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
